# ============================================================
# 大模型（LLM）接入配置
# ------------------------------------------------------------
# 只有「决策报告」页的**大模型润色**这一个功能需要它。不配置也能完整演示：
# 报告页另有「模板渲染」与「离线模拟」两条纯本地路径。
#
# 用法（二选一）
# --------------
# A. 本地运行：把本文件复制为 secrets.toml 并填值
#        cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# B. 托管环境（Streamlit Community Cloud）：在应用的 Settings → Secrets
#    里粘贴同样的内容。
#
# secrets.toml 已在 .gitignore 与 .dockerignore 中，不会被提交或打进镜像。
# 应用启动时会把它桥接成环境变量（见 app/core/report.py::bridge_secrets）。
# 环境变量优先：本地已有 .env 时，secrets 只做兜底补齐。
# ============================================================

# ---- 必填：任何 OpenAI 兼容端点都能用 ----
# OpenAI:      https://api.openai.com/v1        gpt-4o-mini
# DeepSeek:    https://api.deepseek.com/v1      deepseek-chat
# 通义千问:     https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
# 本地 vLLM:   http://127.0.0.1:8000/v1         自定义
LLM_API_KEY  = "sk-在这里填你的密钥"
LLM_BASE_URL = "https://api.deepseek.com/v1"
LLM_MODEL    = "deepseek-chat"

# ---- 可选 ----
# LLM_TIMEOUT = "60"
# LLM_MOCK    = "1"        # =1 时走离线模拟，不产生任何网络请求（用于演示校验器）
# LLM_PROMPT_PRICE      = "0"   # 每百万 token 单价（元），用于成本估算
# LLM_COMPLETION_PRICE  = "0"

# ---- 也可以用别名键（llm_client 会自动识别）----
# DEEPSEEK_API_KEY   = "sk-..."
# OPENAI_API_KEY     = "sk-..."
# DASHSCOPE_API_KEY  = "sk-..."
